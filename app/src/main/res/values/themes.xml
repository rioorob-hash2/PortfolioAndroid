<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Portfolio" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/accent_dim</item>
        <item name="colorOnPrimaryContainer">@color/accent</item>
        <item name="colorSecondary">@color/up</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSecondaryContainer">@color/up_dim</item>
        <item name="colorOnSecondaryContainer">@color/up</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/text_dim</item>
        <item name="colorOutline">@color/stroke</item>
        <item name="colorSurfaceContainer">@color/surface2</item>
        <item name="colorSurfaceContainerHigh">@color/surface3</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_dim</item>
        <item name="android:textColorHint">@color/text_faint</item>
    </style>

    <style name="CardSurface">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Label">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="Value">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.Portfolio.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textSize">12sp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="chipMinHeight">34dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="checkedIcon">@null</item>
    </style>
</resources>
