<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/bg"
            app:navigationIconTint="@color/text"
            app:titleTextColor="@color/text" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="96dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="22dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/stroke"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/coinIcon"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/coinBadge"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_coin"
                                android:gravity="center"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:text="@string/price_now"
                                android:textColor="@color/text_dim"
                                android:textSize="12sp"
                                android:letterSpacing="0.08" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/priceNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="$0"
                            android:textColor="@color/text"
                            android:textSize="30sp"
                            android:textStyle="bold"
                            android:includeFontPadding="false" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/total_value" />

                                <TextView
                                    android:id="@+id/value"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Value"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/pnl" />

                                <TextView
                                    android:id="@+id/pnl"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Value"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/invested" />

                                <TextView
                                    android:id="@+id/invested"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Value"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/Label"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/avg_price" />

                                <TextView
                                    android:id="@+id/avgPrice"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/Value"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/amountRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/targetRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="?attr/selectableItemBackground"
                            android:drawablePadding="6dp"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="22dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/stroke"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/candle_title"
                            android:textColor="@color/text_dim"
                            android:textSize="12sp"
                            android:letterSpacing="0.08" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/candleChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:chipSpacingHorizontal="6dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipDay"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/candle_day"
                                android:checkable="true"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipWeek"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/candle_week"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipMonth"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/candle_month"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipYear"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/candle_year"
                                android:checkable="true" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.brotik.portfolio.ui.CandleChartView
                            android:id="@+id/candleChart"
                            android:layout_width="match_parent"
                            android:layout_height="220dp"
                            android:layout_marginTop="6dp" />

                        <TextView
                            android:id="@+id/candleHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="64dp"
                            android:textColor="@color/text_faint"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="@color/surface"
                    app:cardCornerRadius="22dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/stroke"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleSelection="true"
                            app:selectionRequired="true"
                            app:chipSpacingHorizontal="6dp">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipValue"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_value"
                                android:checkable="true"
                                android:checked="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipPnl"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_pnl"
                                android:checkable="true" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAmount"
                                style="@style/Widget.Portfolio.Chip"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/chart_amount"
                                android:checkable="true" />
                        </com.google.android.material.chip.ChipGroup>

                        <com.brotik.portfolio.ui.LineChartView
                            android:id="@+id/chart"
                            android:layout_width="match_parent"
                            android:layout_height="210dp"
                            android:layout_marginTop="8dp" />

                        <TextView
                            android:id="@+id/chartHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginEnd="64dp"
                            android:textColor="@color/text_faint"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="4dp"
                    android:text="@string/purchases"
                    android:textColor="@color/text_dim"
                    android:textSize="12sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/emptyHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_purchases"
                    android:textColor="@color/text_faint"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:scrollbars="none" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/add_purchase"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/black"
        app:backgroundTint="@color/accent"
        app:elevation="4dp" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
